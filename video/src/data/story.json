  "championCode": "// NAME: Anticipatory Wounded Weaver | NOTE: pre-shot retreats through the shotgun kill zone\nfunction think(s, mem, squad) {\n  if (mem.dir === undefined) {\n    mem.dir = s.uid % 2 === 0 ? \"strafeL\" : \"strafeR\";\n    mem.changed = s.aliveTics;\n    mem.hurt = false;\n  }\n  const freshHurt = s.hurtAgo < 12 && !mem.hurt;\n  mem.hurt = s.hurtAgo < 12;\n  if (freshHurt || s.aliveTics - mem.changed > 70) {\n    mem.dir = mem.dir === \"strafeL\" ? \"strafeR\" : \"strafeL\";\n    mem.changed = s.aliveTics;\n  }\n  if (s.hurtAgo < 70) {\n    return { move: \"retreat\", attack: true };\n  }\n  const shotgun = s.playerWeapon === 2 || s.playerWeapon === 8;\n  if (shotgun && s.dist > 250 && s.dist < 500 &&\n      s.aimOffset < 45 && s.playerFiredAgo > 42) {\n    return { move: \"retreat\", attack: true };\n  }\n  if (s.canSee && s.dist <= 640 && s.aimOffset < 60) {\n    return { move: mem.dir, attack: true };\n  }\n  if (s.canShoot) {\n    return { move: \"hold\", attack: true };\n  }\n  return { move: \"advance\", attack: true };\n}",
