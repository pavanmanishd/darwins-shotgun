# Breeding goes through an OpenClaw gateway (OpenAI-compatible /v1/chat/completions endpoint enabled),
# which runs Kimi K3.1 Pro on Cerebras. The key is the gateway's auth token.
CEREBRAS_BASE_URL=http://127.0.0.1:18810/v1
CEREBRAS_MODEL=openclaw/default
CEREBRAS_API_KEY=
# Optional JSON merged into the request body.
CEREBRAS_EXTRA_BODY=
