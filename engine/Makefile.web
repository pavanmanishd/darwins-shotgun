CC = emcc
OUT_DIR = ../web/public/engine
OBJDIR = build

PORTS = -sUSE_SDL=2 -sUSE_SDL_MIXER=2
CFLAGS += -O2 -MMD -MP -DFEATURE_SOUND $(PORTS) -Wno-everything -Werror=implicit-function-declaration
LDFLAGS += $(PORTS) -sALLOW_MEMORY_GROWTH=1 -sINVOKE_RUN=0 \
	-sEXPORTED_FUNCTIONS=_main,_spawn_monster,_set_autopilot \
	-sEXPORTED_RUNTIME_METHODS=callMain,HEAP32 \
	--preload-file doom1.wad

SRC = dummy am_map doomdef doomstat dstrings d_event d_items d_iwad d_loop d_main d_mode d_net \
	f_finale f_wipe g_game hu_lib hu_stuff info i_cdmus i_endoom i_joystick i_scale i_sound i_system \
	i_timer memio m_argv m_bbox m_cheat m_config m_controls m_fixed m_menu m_misc m_random p_ceilng \
	p_doors p_enemy p_floor p_inter p_lights p_map p_maputl p_mobj p_plats p_pspr p_saveg p_setup \
	p_sight p_spec p_switch p_telept p_tick p_user r_bsp r_data r_draw r_main r_plane r_segs r_sky \
	r_things sha1 sounds statdump st_lib st_stuff s_sound tables v_video wi_stuff w_checksum w_file \
	w_main w_wad z_zone w_file_stdc i_input i_video doomgeneric doomgeneric_emscripten mus2mid \
	i_sdlmusic i_sdlsound brain_bridge
OBJS = $(addprefix $(OBJDIR)/, $(addsuffix .o, $(SRC)))

all: $(OUT_DIR)/doomgeneric.js

$(OUT_DIR)/doomgeneric.js: $(OBJS) doom1.wad
	@mkdir -p $(OUT_DIR)
	$(CC) $(LDFLAGS) $(OBJS) -o $@ -lm

$(OBJDIR)/%.o: %.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR):
	mkdir -p $(OBJDIR)

doom1.wad:
	../scripts/fetch-wad.sh

-include $(OBJS:.o=.d)

clean:
	rm -rf $(OBJDIR) $(OUT_DIR)
